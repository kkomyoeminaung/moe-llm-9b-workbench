{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "intro"
      },
      "source": [
        "# 🚀 MoE LLM Workbench - Autonomous Software Architect\n",
        "ဤ Notebook သည် MoE LLM Workbench ကို Colab သို့မဟုတ် Kaggle တွင် အလိုအလျောက် Setup လုပ်ပြီး Run ပေးမည် ဖြစ်သည်။\n",
        "\n",
        "### ⚙️ Configuration\n",
        "အောက်ပါ cell တွင် သင်လိုအပ်သော setting များကို ပြောင်းလဲနိုင်ပါသည်။"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "clone_repo"
      },
      "outputs": [],
      "source": [
        "# @title 📥 Step 0: Clone Repository\n",
        "import os\n",
        "import sys\n",
        "repo_url = \"https://github.com/kkomyoeminaung/moe-llm-9b-workbench.git\"\n",
        "repo_name = \"moe-llm-9b-workbench\"\n",
        "\n",
        "# 1. GPU Check\n",
        "try:\n",
        "    import torch\n",
        "    if torch.cuda.is_available():\n",
        "        print(f\"✅ GPU Detected: {torch.cuda.get_device_name(0)}\")\n",
        "    else:\n",
        "        print(\"⚠️ WARNING: No GPU detected. The 9B model will be EXTREMELY slow.\")\n",
        "        print(\"👉 Go to Runtime -> Change runtime type -> Hardware accelerator -> T4 GPU.\")\n",
        "except:\n",
        "    pass\n",
        "\n",
        "# 2. Cloning Logic\n",
        "if not os.path.exists(\"package.json\") or not os.path.exists(\"backend\"):\n",
        "    if not os.path.exists(repo_name):\n",
        "        print(f\"📥 Cloning {repo_name}...\")\n",
        "        !git clone {repo_url}\n",
        "        %cd {repo_name}\n",
        "    else:\n",
        "        print(f\"✅ Project directory '{repo_name}' found. Switching context...\")\n",
        "        %cd {repo_name}\n",
        "        !git pull\n",
        "elif os.getcwd().endswith(repo_name):\n",
        "    print(\"✅ Already inside the repository workspace.\")\n",
        "else:\n",
        "    if os.path.exists(repo_name):\n",
        "        print(f\"📂 Switching to {repo_name}...\")\n",
        "        %cd {repo_name}\n",
        "    else:\n",
        "        print(\"⚠️ Project files detected in current root.\")\n",
        "\n",
        "print(f\"📍 Current Working Directory: {os.getcwd()}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "config"
      },
      "outputs": [],
      "source": [
        "# @title 🔧 App Settings\n",
        "ENABLE_HEAVY_TRAINING = False # @param {type:\"boolean\"}\n",
        "RESUME_FROM_CHECKPOINT = True # @param {type:\"boolean\"}\n",
        "USE_WANDB = False # @param {type:\"boolean\"}\n",
        "WANDB_API_KEY = \"\" # @param {type:\"string\"}\n",
        "PORT = 3000 # @param {type:\"integer\"}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "wandb_login"
      },
      "outputs": [],
      "source": [
        "# @title 🔑 Optional: WandB Login\n",
        "if USE_WANDB and WANDB_API_KEY:\n",
        "    import wandb\n",
        "    wandb.login(key=WANDB_API_KEY)\n",
        "elif USE_WANDB:\n",
        "    print(\"⚠️ WandB key missing. Logging will be local-only or disabled.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "drive_mounting"
      },
      "source": [
        "### 📂 Step 0: Persistence (Optional)\n",
        "သင်၏ Model Checkpoints များကို Google Drive တွင် သိမ်းဆည်းလိုပါက အောက်ပါ cell ကို Run ပါ။"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mount_drive"
      },
      "outputs": [],
      "source": [
        "# @title 💾 Step 0: Persistence (Connect Google Drive)\n",
        "USE_GOOGLE_DRIVE = True # @param {type:\"boolean\"}\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "if USE_GOOGLE_DRIVE:\n",
        "    try:\n",
        "        from google.colab import drive\n",
        "        drive.mount('/content/drive')\n",
        "        \n",
        "        # Create folders on Drive\n",
        "        DRIVE_BASE = '/content/drive/MyDrive/MoE_Workbench'\n",
        "        os.makedirs(f'{DRIVE_BASE}/checkpoints', exist_ok=True)\n",
        "        os.makedirs(f'{DRIVE_BASE}/data', exist_ok=True)\n",
        "        \n",
        "        # Symlink Checkpoints\n",
        "        if os.path.exists('checkpoints') and not os.path.islink('checkpoints'):\n",
        "            !rm -rf checkpoints\n",
        "        if not os.path.exists('checkpoints'):\n",
        "            os.symlink(f'{DRIVE_BASE}/checkpoints', 'checkpoints')\n",
        "            \n",
        "        # Symlink Data (Persist massive datasets)\n",
        "        if os.path.exists('data') and not os.path.islink('data'):\n",
        "            !mv data/* {DRIVE_BASE}/data/ 2>/dev/null || true\n",
        "            !rm -rf data\n",
        "        if not os.path.exists('data'):\n",
        "            os.symlink(f'{DRIVE_BASE}/data', 'data')\n",
        "\n",
        \"        print(\\\"✅ Everything (Data & Checkpoints) is now synced with Google Drive!\\\")\\n\",
        \"    except ImportError:\\n\",
        \"        if os.path.exists('/kaggle/working'):\\n\",
        \"            print(\\\"📂 Detected Kaggle Environment.\\\")\\n\",
        \"            os.makedirs('/kaggle/working/data', exist_ok=True)\\n\",
        \"            os.makedirs('/kaggle/working/checkpoints', exist_ok=True)\\n\",
        \"            os.makedirs('/kaggle/working/models', exist_ok=True)\\n\",
        \"            print(\\\"✅ Kaggle persistence folders ready.\\\")\\n\",
        \"        else:\\n\",
        \"            print(\\\"ℹ️ Not running in Google Colab. Google Drive mirroring skipped.\\\")\\n\",
        \"    except Exception as e:\\n\",
        \"        print(f\\\"⚠️ Failed to mount Google Drive: {e}\\\")\"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "setup"
      },
      "outputs": [],
      "source": [
        "# @title 🛠️ Step 1: System Setup\n",
        "import os\n",
        "\n",
        "# Run the setup script to install dependencies\n",
        "!chmod +x setup_colab.sh\n",
        "!./setup_colab.sh"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "model_prep"
      },
      "outputs": [],
      "source": [
        "# @title 🧠 Step 2: Model & Data Preparation\n",
        "import os\n",
        "from pathlib import Path\n",
        "\n",
        "# Check for any available high-quality models first\n",
        "model_priority = [\n",
        "    Path(\"checkpoints/best.pt\"),\n",
        "    Path(\"checkpoints/moe_final.pt\"),\n",
        "    Path(\"checkpoints/last.pt\"),\n",
        "    Path(\"checkpoints/moe_model_complete.pt\")\n",
        "]\n",
        "\n",
        "found_model = None\n",
        "for m in model_priority:\n",
        "    if m.exists():\n",
        "        found_model = m\n",
        "        break\n",
        "\n",
        "if ENABLE_HEAVY_TRAINING:\n",
        "    print(\"🏋️ Heavy Training Mode Active...\")\n",
        "    \n",
        "    # Step A: Data Generation (Resumes automatically if partial file exists)\n",
        "    print(\"📊 Ensuring training dataset is ready...\")\n",
        "    !python3 training/generate_large_dataset.py --size_per_domain 5000\n",
        "    \n",
        "    # Step B: Heavy Training (Auto-resumes from last.pt or best.pt)\n",
        "    print(\"🚀 Launching Training Engine...\")\n",
        "    wandb_flag = \"--use_wandb\" if USE_WANDB else \"\"\n",
        "    !python3 training/train_unified.py {wandb_flag} --epochs 10\n",
        "else:\n",
        "    if found_model:\n",
        "        print(f\"✅ Found established model: {found_model}. Skipping heavy training.\")\n",
        "    else:\n",
        "        print(\"⚡ No existing model. Building a quick initialization model to start UI...\")\n",
        "        # Ensure minimal data for fast mode\n",
        "        if not os.path.exists(\"data/train.jsonl\"):\n",
        "            !python3 training/generate_large_dataset.py --size_per_domain 100\n",
        "        !python3 training/train_unified.py --fast_mode\n",
        "        \n",
        "print(\"\\n🏁 Model Preparation Complete.\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "run",
        "colab": {
          "background_output": true
        }
      },
      "outputs": [],
      "source": [
        "# @title 🌐 Step 3: Launch Workbench\n",
        "import time\n",
        "import subprocess\n",
        "import urllib.request\n",
        "import json\n",
        "import os\n",
        "\n",
        "def get_public_ip():\n",
        "    try:\n",
        "        return urllib.request.urlopen('https://ident.me', timeout=5).read().decode('utf8')\n",
        "    except: return \"Not Found\"\n",
        "\n",
        "PUBLIC_IP = get_public_ip()\n",
        "\n",
        "print(\"📡 Starting Backend (Unified Intelligence Platform) on port 8080... \")\n",
        "get_ipython().system_raw('python3 backend/app_unified.py &')\n",
        "\n",
        "print(\"🛰️ Starting Frontend (Express/Vite Proxy) on port 3000... \")\n",
        "os.environ[\"VITE_API_URL\"] = \"http://localhost:8080\"\n",
        "get_ipython().system_raw('npm run dev -- --host 0.0.0.0 &')\n",
        "\n",
        "print(\"⏳ Waiting for brain stabilization (downloading weights)... \")\n",
        "max_retries = 150\n",
        "frontend_ready = False\n",
        "backend_ready = False\n",
        "\n",
        "for i in range(max_retries):\n",
        "    if not frontend_ready:\n",
        "        try:\n",
        "            with urllib.request.urlopen(\"http://127.0.0.1:3000/healthz\", timeout=1) as f:\n",
        "                if f.getcode() == 200: frontend_ready = True\n",
        "        except: pass\n",
        "    \n",
        "    if not backend_ready:\n",
        "        try:\n",
        "            with urllib.request.urlopen(\"http://127.0.0.1:8080/stats\", timeout=1) as f:\n",
        "                if f.getcode() == 200:\n",
        "                    data = json.loads(f.read().decode())\n",
        "                    if data.get(\"status\") != \"loading\": backend_ready = True\n",
        "        except: pass\n",
        "            \n",
        "    if frontend_ready and backend_ready:\n",
        "        print(\"✅ System Neural Integrity Verified (100%)\")\n",
        "        break\n",
        "    if i % 6 == 0: print(f\"   [SYNC] Attempting handshake... ({i*5}s)\")\n",
        "    time.sleep(5)\n",
        "\n",
        "print(\"\\n🚀 MoE Workbench is LIVE!\")\n",
        "\n",
        "try:\n",
        "    from google.colab import output\n",
        "    print(f\"Access UI via Colab Proxy: http://localhost:{PORT}\")\n",
        "    output.proxy_port(PORT)\n",
        "except (ImportError, Exception):\n",
        "    print(\"ℹ️ Standard proxy failed. Using Localtunnel for public access...\")\n",
        "    os.system(\"npm install -g localtunnel &> /dev/null\")\n",
        "    \n",
        "    import random, string\n",
        "    subdomain = \"moe-llm-\" + \"\".join(random.choices(string.ascii_lowercase + string.digits, k=8))\n",
        "    \n",
        "    print(f\"\\n🔑 TUNNEL PASSWORD: {PUBLIC_IP}\")\n",
        "    print(\"(Copy this password for the localtunnel prompt)\")\n",
        "    \n",
        "    tunnel_process = subprocess.Popen([\"lt\", \"--port\", \"3000\", \"--subdomain\", subdomain], stdout=subprocess.PIPE, text=True)\n",
        "    time.sleep(5)\n",
        "    line = tunnel_process.stdout.readline()\n",
        "    if \"your url is\" in line.lower():\n",
        "        url = line.strip().split(\" \")[-1]\n",
        "        print(\"=\"*60)\n",
        "        print(f\"🎉 SUCCESS! URL: {url}\")\n",
        "        print(f\"🔑 PASSWORD: {PUBLIC_IP}\")\n",
        "        print(\"=\"*60)\n"
      ]
    }
