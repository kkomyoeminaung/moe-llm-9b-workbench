   "cell_type": "markdown",
   "metadata": {},
   "source": ["# Step 1: Generate 100k Labeled Sentences Dataset"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import json\n",
    "import random\n",
    "from pathlib import Path\n",
    "\n",
    "# Domain word banks\n",
    "DOMAIN_WORDS = {\n",
    "    0: [\"hello\", \"hi\", \"how\", \"are\", \"you\", \"good\", \"day\", \"talk\", \"chat\", \"help\"],\n",
    "    1: [\"engine\", \"motor\", \"circuit\", \"load\", \"stress\", \"beam\", \"turbine\", \"pump\", \"gear\", \"bearing\"],\n",
    "    2: [\"atom\", \"molecule\", \"force\", \"energy\", \"cell\", \"gene\", \"reaction\", \"acid\", \"protein\", \"electron\"],\n",
    "    3: [\"heart\", \"brain\", \"liver\", \"cell\", \"symptom\", \"fever\", \"pain\", \"surgery\", \"drug\", \"patient\"],\n",
    "    4: [\"function\", \"class\", \"variable\", \"loop\", \"array\", \"pointer\", \"thread\", \"async\", \"compile\", \"debug\"],\n",
    "    5: [\"god\", \"prayer\", \"faith\", \"scripture\", \"temple\", \"church\", \"mosque\", \"bible\", \"quran\", \"meditate\"],\n",
    "    6: [\"king\", \"war\", \"empire\", \"revolution\", \"ancient\", \"medieval\", \"century\", \"battle\", \"treaty\", \"colony\"],\n",
    "    7: [\"market\", \"price\", \"demand\", \"supply\", \"stock\", \"bond\", \"inflation\", \"gdp\", \"trade\", \"capital\"],\n",
    "    8: [\"vote\", \"party\", \"congress\", \"policy\", \"law\", \"rights\", \"democracy\", \"election\", \"senate\", \"govern\"],\n",
    "    9: [\"poem\", \"novel\", \"chapter\", \"verse\", \"metaphor\", \"plot\", \"character\", \"prose\", \"rhyme\", \"fiction\"]\n",
    "}\n",
    "\n",
    "def generate_sentence(domain, length=10):\n",
    "    words = random.choices(DOMAIN_WORDS[domain], k=length)\n",
    "    # Add some common words\n",
    "    common = [\"the\", \"a\", \"and\", \"of\", \"to\", \"in\", \"that\", \"it\", \"for\", \"with\"]\n",
    "    for i in range(0, len(words), 3):\n",
    "        words.insert(random.randint(0, len(words)), random.choice(common))\n",
    "    return words[:length]\n",
    "\n",
    "# Generate 100k samples (10k per domain)\n",
    "dataset = []\n",
    "for domain in range(10):\n",
    "    for i in range(10000):\n",
    "        length = random.randint(5, 20)\n",
    "        sentence = generate_sentence(domain, length)\n",
    "        # Next word prediction task\n",
    "        next_word = random.choice(DOMAIN_WORDS[domain])\n",
    "        dataset.append({\n",
    "            \"sentence\": sentence,\n",
    "            \"domain\": domain,\n",
    "            \"next_word\": next_word\n",
    "        })\n",
    "\n",
    "# Save\n",
    "output_path = Path(\"data/train.jsonl\")\n",
    "output_path.parent.mkdir(exist_ok=True)\n",
    "with open(output_path, \"w\") as f:\n",
    "    for sample in dataset:\n",
    "        f.write(json.dumps(sample) + \"\\n\")\n",
    "\n",
    "print(f\"✅ Generated {len(dataset)} samples\")\n",
    "print(\"📁 Saved to data/train.jsonl\")\n",
    "print(f\"📊 Per domain: {len(dataset) // 10} samples\")"
   ]
  }
 ]
}
