# Step 3: 4bit Quantization + QLoRA + GGUF Export
import torch
from transformers import BitsAndBytesConfig
from peft import LoraConfig, get_peft_model, TaskType
import gguf
import struct
import numpy as np
from pathlib import Path
from model import SparseMoE
from config import *

# Load model
model = SparseMoE(vocab_size=VOCAB_SIZE, embed_dim=EMBED_DIM, num_experts=NUM_EXPERTS)
model.load_state_dict(torch.load("models/moe_5b_final.pt"))

# 4bit quantization config
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_compute_dtype=torch.float16,
    bnb_4bit_use_double_quant=True,
    bnb_4bit_quant_type="nf4"
)

# QLoRA for each expert
lora_config = LoraConfig(
    task_type=TaskType.CAUSAL_LM,
    r=16,
    lora_alpha=32,
    target_modules=["q_proj", "v_proj"],
    lora_dropout=0.05,
    bias="none"
)

# Apply QLoRA to all experts
for i, expert in enumerate(model.experts):
    # Replace each expert with LoRA version
    model.experts[i] = get_peft_model(expert, lora_config)
    model.experts[i] = model.experts[i].to("cuda" if torch.cuda.is_available() else "cpu")
    print(f"✅ Applied QLoRA to Expert {i}")

# Quantize weights to 4-bit
def quantize_4bit(tensor):
    """Quantize float32 to 4-bit (NF4 style)"""
    abs_max = tensor.abs().max()
    scale = 15.0 / (abs_max + 1e-8)
    quantized = (tensor * scale).round().clamp(-15, 15).to(torch.int8)
    return quantized, abs_max

# Convert to GGUF format
def to_gguf(model, output_path):
    output_path = Path(output_path)
    output_path.parent.mkdir(exist_ok=True)
    
    gguf_writer = gguf.GGUFWriter(str(output_path), "moe_llm")
    
    # Write metadata
    gguf_writer.add_uint32("vocab_size", VOCAB_SIZE)
    gguf_writer.add_uint32("embed_dim", EMBED_DIM)
    gguf_writer.add_uint32("num_experts", NUM_EXPERTS)
    gguf_writer.add_uint32("num_active", NUM_ACTIVE)
    gguf_writer.add_string("expert_domains", str(DOMAINS))
    gguf_writer.add_uint32("context_length", CONTEXT_LEN)
    
    # Write quantized weights
    for name, param in model.named_parameters():
        if param.requires_grad and param.numel() > 1000:  # Skip tiny params
            quantized, scale = quantize_4bit(param.float().cpu().detach())
            gguf_writer.add_tensor(name, quantized.numpy())
            gguf_writer.add_tensor(f"{name}.scale", np.array([scale], dtype=np.float32))
            print(f"  Quantized {name}: {param.numel():,} params → {quantized.numel():,} bytes")
    
    gguf_writer.close()
    print(f"✅ Exported to {output_path}")

# Export
to_gguf(model, "models/moe_5b_q4_K_M.gguf")

# Also save PyTorch 4bit version
torch.save(model.state_dict(), "models/moe_5b_4bit.pt")
print("✅ 4bit PyTorch saved to models/moe_5b_4bit.pt")

# Calculate size
import os
size_mb = os.path.getsize("models/moe_5b_q4_K_M.gguf") / (1024 * 1024)
print(f"📦 GGUF file size: {size_mb:.1f} MB")
print(f"💾 Estimated RAM usage: {size_mb / 1024:.1f} GB")
