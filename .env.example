# MoE LLM 9B Workbench Configuration

# AI Studio automatically injects this at runtime
APP_URL="MY_APP_URL"

# Hugging Face Settings
HF_TOKEN="your_hf_token_here"
EXTERNAL_MODEL_PATH="kkomyoeminaung/Qwen2.5-7B-Merged-Coder-Math"
MY_WEIGHTS_URL="https://huggingface.co/kkomyoeminaung/MoL-7B/resolve/main/best.pt"

# Runtime Settings
QUANTIZATION="4bit" # Options: 4bit, 8bit, none
DEVICE="cuda" # Options: cuda, cpu
START_BACKEND="false" # Set to true to run backend in the same container (may OOM)
BACKEND_URL="http://127.0.0.1:8080"
